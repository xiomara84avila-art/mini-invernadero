#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

const char* ssid = "Familia_Zambrano";
const char* password = "20082018";

ESP8266WebServer server(80);

LiquidCrystal_I2C lcd(0x27, 20, 4);

#define BTN_RESP D5
#define BTN_RESET D6

bool lastResp = HIGH;
bool lastReset = HIGH;

void cors() {
  server.sendHeader("Access-Control-Allow-Origin", "*");
}

String limpiarLCD(String txt){

txt.replace("á","a");
txt.replace("é","e");
txt.replace("í","i");
txt.replace("ó","o");
txt.replace("ú","u");
txt.replace("ñ","n");
txt.replace("¿","");
txt.replace("?","");
txt.replace("¡","");
txt.replace("!","");

return txt;

}

void linea(int fila, String txt){

txt = limpiarLCD(txt);

while(txt.length() < 20){
txt += " ";
}

lcd.setCursor(0,fila);
lcd.print(txt.substring(0,20));

}

void pantalla(
String l1,
String l2="",
String l3="",
String l4=""
){

lcd.clear();

linea(0,l1);
linea(1,l2);
linea(2,l3);
linea(3,l4);

}

void setup() {

Serial.begin(115200);

pinMode(BTN_RESP, INPUT_PULLUP);
pinMode(BTN_RESET, INPUT_PULLUP);

Wire.begin(D2,D1);

lcd.init();
lcd.backlight();

pantalla(
"TIMBITO QUIZ",
"Iniciando..."
);

WiFi.mode(WIFI_STA);
WiFi.begin(ssid,password);

while(WiFi.status()!=WL_CONNECTED){

delay(500);
Serial.print(".");

}

pantalla(
"WIFI CONECTADO",
WiFi.localIP().toString(),
"",
"Servidor listo"
);

server.on("/ping",[](){

cors();
server.send(200,"text/plain","OK");

});

server.on("/mostrar",[](){

String a =
server.arg("a");

String b =
server.arg("b");

String c =
server.arg("c");

String d =
server.arg("d");

pantalla(a,b,c,d);

cors();
server.send(200,"text/plain","OK");

});

server.on("/estado",[](){

String json="{";

json += "\"resp\":";
json += digitalRead(BTN_RESP)==LOW ? "1":"0";

json += ",";

json += "\"reset\":";
json += digitalRead(BTN_RESET)==LOW ? "1":"0";

json += "}";

cors();

server.send(
200,
"application/json",
json
);

});

server.on("/velocidad",[](){

int v = random(20,120);

cors();

server.send(
200,
"text/plain",
String(v)
);

});

server.begin();

}

void loop() {

server.handleClient();

}